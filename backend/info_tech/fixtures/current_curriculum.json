{
  "model": "info_tech.question",
  "pk": 114,
  "fields": {
    "unit": 9,
    "difficulty": "easy",
    "category": "互联网的诞生与发展",
    "text": "互联网的雏形是（ ）",
    "answer": "A",
    "explanation": "1969年，美国国防部高级研究计划署创建了ARPANET（阿帕网），这是互联网的前身和雏形。万维网（WWW）是1990年蒂姆·伯纳斯-李发明的；TCP/IP协议是1983年ARPANET采用的通信协议；DNS系统是域名系统，用于将域名转换为IP地址，三者都是在ARPANET之后才出现的技术。",
    "option_a": "ARPANET",
    "option_b": "万维网",
    "option_c": "TCP/IP协议",
    "option_d": "DNS系统",
    "created_at": "2026-04-24T01:17:22.758Z",
    "updated_at": "2026-04-24T01:17:22.759Z"
  }
},
