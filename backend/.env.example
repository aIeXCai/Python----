# development | test | production
DJANGO_ENV=development

# 生产环境必须替换为至少 32 位的随机值，禁止提交真实值。
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_LOG_LEVEL=INFO

# 学生代码执行总开关。阶段 5 Runner 完成前，生产环境即使开启也不会
# 回退到 Django Web 进程执行；关闭时相关接口返回 503。
CODE_EXECUTION_ENABLED=true
EXECUTION_CODE_MAX_BYTES=65536
EXECUTION_STDIN_MAX_BYTES=65536
EXECUTION_TEST_CASE_MAX_BYTES=65536
EXECUTION_TEST_CASES_MAX=100
EXECUTION_USER_RUNNING_LIMIT=1
EXECUTION_USER_QUEUED_LIMIT=2
EXECUTION_QUEUE_TTL_SECONDS=120
EXECUTION_LEASE_SECONDS=30
EXECUTION_MAX_ATTEMPTS=2
EXECUTION_MAX_OUTPUT_BYTES=131072
EXECUTION_MAX_RESULT_BYTES=262144
RUNNER_PROTOCOL_VERSION=runner.v1
# Runner 独立 HMAC 密钥；生产环境至少 32 位，不得与 Django/Token/数据库密钥复用。
RUNNER_SERVICE_SECRET=replace-with-an-independent-runner-secret
RUNNER_CLOCK_SKEW_SECONDS=60
RUNNER_RECEIPT_TTL_SECONDS=86400
RUNNER_NODE_STALE_SECONDS=30

# 正式环境必须使用 mysql；本地开发可改回 sqlite。
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=python_learning
DJANGO_DB_USER=python_learning
DJANGO_DB_PASSWORD=replace-with-database-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONNECT_TIMEOUT=5
DJANGO_DB_TEST_NAME=test_python_learning

# 学生可恢复密码使用独立 Fernet 密钥。真实值不要写入本文件；
# 本地执行 scripts/stage3_security_local.sh init，生产环境由安全环境变量注入。
DJANGO_STUDENT_PASSWORD_KEYS=stage3-v1:replace-with-a-generated-fernet-key
DJANGO_STUDENT_PASSWORD_PRIMARY_KEY_ID=stage3-v1
DJANGO_TOKEN_TTL_HOURS=12
DJANGO_PASSWORD_REVEAL_LIMIT=30
DJANGO_PASSWORD_REVEAL_SECONDS=30

# 生产 HTTPS 反向代理安全设置
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# 第三方 AI 密钥仍通过环境变量注入
MINIMAX_API_KEY=
